<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.WorkoutPlan" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryVariant">@color/primaryDarkColor</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondaryColor</item>
        <item name="colorSecondaryVariant">@color/secondaryDarkColor</item>
        <item name="colorOnSecondary">@color/secondaryLightColor</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
        <item name="android:textColor">@color/primaryTextColor</item>
    </style>

    <style name="CustomTabLayout" parent="Widget.Design.TabLayout">
        <item name="tabIndicatorColor">@color/primaryColor</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabBackground">?attr/selectableItemBackground</item>
        <item name="tabTextAppearance">@style/CustomTabTextAppearance</item>
        <item name="tabSelectedTextColor">@color/primaryColor</item>
    </style>

    <style name="CustomTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textColor">@color/primaryColor</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">true</item>
    </style>

    <!-- Custom view for all divider in the app-->
    <style name="CustomViewDivider">
        <item name="android:background">@drawable/simple_line</item>
        <item name="android:alpha">0.2</item>
    </style>

    <style name="MaterialCardViewFlat">
        <item name="strokeWidth">@dimen/no_size</item>
        <item name="cardElevation">@dimen/no_size</item>
        <item name="strokeColor">@color/primaryColor</item>
        <item name="android:animateLayoutChanges">true</item>
    </style>

    <style name="WorkoutImageBadges">
        <item name="android:padding">5dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">@drawable/shape</item>
    </style>

    <style name="FloatingAddWorkout" parent="Widget.Design.FloatingActionButton">
        <item name="backgroundTint">@color/primaryColor</item>
        <item name="srcCompat">@drawable/add</item>
    </style>

    <style name="SessionRatingBar" parent="Widget.AppCompat.RatingBar">
        <item name="android:progressDrawable">@drawable/ic_rating_star</item>
        <item name="colorControlNormal">@color/material_dynamic_neutral80</item>
    </style>
</resources>