<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_home"
    app:startDestination="@id/homeFragment2">

    <fragment
        android:id="@+id/homeFragment2"
        android:name="com.example.workoutplan.fragments.HomeFragment"
        android:label="HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment2_to_workoutExercisesFragment"
            app:destination="@id/workoutExercisesFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_homeFragment2_to_aboutFragment"
            app:destination="@id/aboutFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>
    <fragment
        android:id="@+id/workoutExercisesFragment"
        android:name="com.example.workoutplan.fragments.WorkoutExercisesFragment"
        android:label="WorkoutExercisesFragment"
        tools:layout="@layout/fragment_workout_exercises">
        <action
            android:id="@+id/action_workoutExercisesFragment_to_exercisePageFragment2"
            app:destination="@id/exercisePageFragment" />
        <action
            android:id="@+id/action_workoutExercisesFragment_to_workoutExercisePageFragment"
            app:destination="@id/workoutExercisePageFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in" />
        <argument
            android:name="workoutId"
            app:argType="long" />
        <action
            android:id="@+id/action_workoutExercisesFragment_to_sessionFragment2"
            app:destination="@id/sessionFragment2" />
    </fragment>
    <fragment
        android:id="@+id/workoutExercisePageFragment"
        android:name="com.example.workoutplan.fragments.WorkoutExercisePageFragment"
        android:label="WorkoutExercisePageFragment"
        tools:layout="@layout/fragment_workout_exercise_page">
        <argument android:name="exerciseId"
            app:argType="long" />
        <action
            android:id="@+id/action_workoutExercisePageFragment_to_workoutExercisesFragment"
            app:destination="@id/workoutExercisesFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popExitAnim="@anim/fade_out" />
        <argument android:name="workoutId"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/aboutFragment"
        android:name="com.example.workoutplan.fragments.AboutFragment"
        android:label="AboutFragment"
        tools:layout="@layout/fragment_about">
        <action
            android:id="@+id/action_aboutFragment_to_homeFragment2"
            app:destination="@id/homeFragment2"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>
    <fragment
        android:id="@+id/sessionFragment2"
        android:name="com.example.workoutplan.fragments.SessionFragment"
        android:label="SessionFragment"
        tools:layout="@layout/fragment_session">
        <action
            android:id="@+id/action_sessionFragment2_to_sessionSummaryFragment2"
            app:destination="@id/sessionSummaryFragment2" />
        <action
            android:id="@+id/action_sessionFragment2_to_workoutExercisePageFragment"
            app:destination="@id/workoutExercisePageFragment" />
    </fragment>
    <fragment
        android:id="@+id/sessionSummaryFragment2"
        android:name="com.example.workoutplan.fragments.SessionSummaryFragment"
        android:label="SessionSummaryFragment"
        tools:layout="@layout/fragment_session_summary">
        <action
            android:id="@+id/action_sessionSummaryFragment2_to_homeFragment2"
            app:destination="@id/homeFragment2" />
    </fragment>

</navigation>