<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="sessionViewModel"
            type="com.example.workoutplan.viewmodels.SessionViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:fitsSystemWindows="true">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!--START GUIDELINES-->

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_hor_fs_top_btn_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="0dp"
                app:layout_constraintGuide_percent=" 0.01 " />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_hor_fs_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="0dp"
                app:layout_constraintGuide_percent=" 0.1 " />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_hor_fs_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="0dp"
                app:layout_constraintGuide_percent=" 0.05" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_hor_fs_top_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="0dp"
                app:layout_constraintGuide_percent=" 0.22 " />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_hor_fs_bottom_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="0dp"
                app:layout_constraintGuide_percent=" 0.38 " />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_hor_fs_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="0dp"
                app:layout_constraintGuide_percent=" 0.51 " />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_hor_fs_progressbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="0dp"
                app:layout_constraintGuide_percent=" 0.55 " />


            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_hor_fs_bottom_progressbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="0dp"
                app:layout_constraintGuide_percent=" 0.54 " />


            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_hor_fs_recyclerview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="0dp"
                app:layout_constraintGuide_percent=" 0.70 " />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_hor_fs_top_main_board"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="0dp"
                app:layout_constraintGuide_percent=" 0.75 " />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_hor_fs_top_board"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="0dp"
                app:layout_constraintGuide_percent=" 0.77 " />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_hor_fs_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="0dp"
                app:layout_constraintGuide_percent=" 0.88 " />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_hor_fs_bottom_board"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="0dp"
                app:layout_constraintGuide_percent=" 0.86 " />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_vert_fs_start_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_end="224dp"
                app:layout_constraintGuide_percent=" 0.30 "/>

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_vert_fs_start_btnPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="0dp"
                app:layout_constraintGuide_percent=" 0.38 " />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_vert_fs_end_btnPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="0dp"
                app:layout_constraintGuide_percent=" 0.63 " />


            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_vert_fs_end_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="0dp"
                app:layout_constraintGuide_percent=" 0.7 " />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_vert_start_btnPrev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="0dp"
                app:layout_constraintGuide_percent=" 0.15 " />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_vert_fs_end_btnNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="0dp"
                app:layout_constraintGuide_percent=" 0.85 " />

            <!--END GUIDELINES-->

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/session_exercise_title"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fontFamily="@font/telex"
                android:gravity="center"
                app:autoSizeTextType="uniform"
                app:layout_constraintBottom_toBottomOf="@id/guide_hor_fs_title"
                app:layout_constraintDimensionRatio="3:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Military press" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_info"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/ic_info_outline_white_24dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintBottom_toBottomOf="@+id/guide_hor_fs_info"
                app:layout_constraintStart_toEndOf="@id/session_exercise_title"
                app:layout_constraintTop_toTopOf="@id/guide_hor_fs_top_btn_info" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/custom_progressbar"
                android:max="100"
                android:progress="70"
                android:progressDrawable="@drawable/custom_progressbar"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintBottom_toBottomOf="@id/guide_hor_fs_bottom_progressbar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/guide_hor_fs_title" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/image_session"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_crunch"
                exerciseSessionImage="@{sessionViewModel.actualExerciseId}"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintBottom_toBottomOf="@+id/guide_hor_fs_bottom_image"
                app:layout_constraintEnd_toEndOf="@+id/guide_vert_fs_end_image"
                app:layout_constraintStart_toStartOf="@+id/guide_vert_fs_start_image"
                app:layout_constraintTop_toTopOf="@+id/guide_hor_fs_top_image" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_timer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fontFamily="@font/telex"
                android:fontWeight="900"
                android:gravity="center"
                android:maxLines="1"
                tools:text="00:20"
                android:textColor="@color/primaryDarkColor"
                app:autoSizeTextType="uniform"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintBottom_toBottomOf="@+id/guide_hor_fs_timer"
                app:layout_constraintEnd_toEndOf="@+id/progressBar"
                app:layout_constraintStart_toStartOf="@+id/progressBar"
                app:layout_constraintTop_toBottomOf="@id/image_session" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_set"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="1"
                android:orientation="horizontal"
                tools:listitem="@layout/list_item_session_set"
                android:layout_gravity="center_horizontal"
                app:layout_constraintBottom_toBottomOf="@id/guide_hor_fs_recyclerview"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/guide_hor_fs_progressbar"/>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_prev_exercise"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/ic_btn_prev"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintBottom_toBottomOf="@id/guide_hor_fs_bottom_board"
                app:layout_constraintEnd_toEndOf="@+id/guide_vert_fs_start_btnPlay"
                app:layout_constraintStart_toEndOf="@id/image_prev_exercise"
                app:layout_constraintTop_toTopOf="@+id/guide_hor_fs_top_board" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_stop_session"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/ic_btn_play"
                android:foreground="?android:attr/actionBarItemBackground"
                app:shapeAppearance="?attr/shapeAppearanceLargeComponent"
                app:strokeWidth="5dp"
                app:strokeColor="@color/red"
                android:elevation="2dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintEnd_toEndOf="@+id/guide_vert_fs_end_btnPlay"
                app:layout_constraintBottom_toBottomOf="@+id/guide_hor_fs_bottom_board"
                app:layout_constraintStart_toStartOf="@+id/guide_vert_fs_start_btnPlay"
                app:layout_constraintTop_toTopOf="@+id/guide_hor_fs_top_main_board" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_next_exercise"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/ic_btn_next"
                android:gravity="right"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintBottom_toBottomOf="@id/guide_hor_fs_bottom_board"
                app:layout_constraintEnd_toStartOf="@id/image_next_exercise"
                app:layout_constraintStart_toStartOf="@+id/guide_vert_fs_end_btnPlay"
                app:layout_constraintTop_toTopOf="@+id/guide_hor_fs_top_board" />

            <ImageView
                android:id="@+id/image_prev_exercise"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitCenter"
                tools:src="@drawable/ic_running"
                android:layout_marginRight="1dp"
                android:layout_marginHorizontal="3dp"
                exerciseSessionImage="@{sessionViewModel.previousExerciseId}"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="@id/guideline_vert_start_btnPrev"
                app:layout_constraintBottom_toBottomOf="@id/guide_hor_fs_bottom_board"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/guide_hor_fs_top_board" />

            <ImageView
                android:id="@+id/image_next_exercise"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitCenter"
                exerciseSessionImage="@{sessionViewModel.nextExerciseId}"
                tools:src="@drawable/ic_flipping_tire"
                app:layout_constraintBottom_toBottomOf="@id/guide_hor_fs_bottom_board"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/guideline_vert_fs_end_btnNext"
                app:layout_constraintTop_toTopOf="@+id/guide_hor_fs_top_board" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_stop_session"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:backgroundTint="@color/white"
                android:text="@string/stop"
                android:textAlignment="center"
                android:textAllCaps="true"
                android:textColor="@color/red"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_btn_stop"
                app:iconGravity="textStart"
                app:iconTint="@color/red"
                app:layout_constraintDimensionRatio="5:1"
                app:strokeColor="@color/red"
                app:strokeWidth="3dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/guideline_vert_fs_end_btnNext"
                app:layout_constraintStart_toStartOf="@id/guideline_vert_start_btnPrev"
                app:layout_constraintTop_toTopOf="@id/guide_hor_fs_button"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>