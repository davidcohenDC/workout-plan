<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="sessionViewModel"
            type="com.example.workoutplan.viewmodels.SessionViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:fitsSystemWindows="true">

        <FrameLayout
            android:id="@+id/frameLayout2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            tools:context="com.example.workoutplan.fragments.ExerciseBookFragment">


        </FrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_anchor="@+id/frameLayout2"
            app:layout_anchorGravity="center">


            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/session_exercise_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_elevation"
                android:fontFamily="@font/telex"
                android:textAppearance="?attr/textAppearanceHeadline4"
                app:layout_constraintBottom_toTopOf="@id/progressBar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Military press" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/imageButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/ic_info_outline_white_24dp"
                app:layout_constraintBottom_toBottomOf="@+id/session_exercise_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.257"
                app:layout_constraintStart_toEndOf="@id/session_exercise_title"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.25" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:background="@drawable/custom_progressbar"
                android:max="100"
                android:progress="80"
                android:progressDrawable="@drawable/custom_progressbar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/session_exercise_title" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/image_session"
                android:layout_width="110dp"
                android:layout_height="150dp"
                android:src="@drawable/ic_crunch"
                android:scaleType="fitCenter"
                app:icon="@drawable/ic_running"
                app:layout_constraintBottom_toBottomOf="@+id/progressBar"
                app:layout_constraintEnd_toEndOf="@+id/progressBar"
                app:layout_constraintHorizontal_bias="0.496"
                app:layout_constraintStart_toStartOf="@+id/progressBar"
                app:layout_constraintTop_toTopOf="@+id/progressBar"
                app:layout_constraintVertical_bias="0.386" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/materialTextView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/telex"
                android:textColor="@color/primaryDarkColor"
                android:textAlignment="center"
                android:fontWeight="900"
                android:textSize="38sp"
                app:layout_constraintBottom_toBottomOf="@+id/progressBar"
                app:layout_constraintEnd_toEndOf="@+id/progressBar"
                app:layout_constraintHorizontal_bias="0.498"
                app:layout_constraintStart_toStartOf="@+id/progressBar"
                app:layout_constraintTop_toBottomOf="@id/image_session"
                app:layout_constraintVertical_bias="0.2"
                tools:text="00:20" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_prev_exercise"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/ic_btn_prev"
                app:layout_constraintBottom_toTopOf="@id/btn_stop_session"
                app:layout_constraintEnd_toStartOf="@+id/btn_start_stop_session"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toEndOf="@id/image_prev_exercise"
                app:layout_constraintTop_toBottomOf="@+id/progressBar"
                app:layout_constraintVertical_bias="0.725" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_stop_session"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:background="@drawable/ic_btn_play"
                app:layout_constraintBottom_toTopOf="@+id/btn_stop_session"
                app:layout_constraintEnd_toStartOf="@+id/btn_next_exercise"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toEndOf="@+id/btn_prev_exercise"
                app:layout_constraintTop_toBottomOf="@+id/progressBar"
                app:layout_constraintVertical_bias="0.714" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_next_exercise"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/ic_btn_next"
                app:layout_constraintBottom_toTopOf="@id/btn_stop_session"
                app:layout_constraintEnd_toStartOf="@id/image_next_exercise"
                app:layout_constraintStart_toEndOf="@+id/btn_start_stop_session"
                app:layout_constraintTop_toBottomOf="@+id/progressBar"
                app:layout_constraintVertical_bias="0.725" />

            <ImageView
                android:id="@+id/image_prev_exercise"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_running"
                app:layout_constraintBottom_toTopOf="@id/btn_stop_session"
                app:layout_constraintEnd_toStartOf="@id/btn_prev_exercise"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/progressBar"
                app:layout_constraintVertical_bias="0.767" />

            <ImageView
                android:id="@+id/image_next_exercise"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_flipping_tire"
                app:layout_constraintBottom_toTopOf="@id/btn_stop_session"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/btn_next_exercise"
                app:layout_constraintTop_toBottomOf="@+id/progressBar"
                app:layout_constraintVertical_bias="0.777" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_stop_session"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="50dp"
                android:layout_marginBottom="5dp"
                android:text="@string/stop"
                app:strokeColor="@color/red"
                app:cornerRadius="10dp"
                app:strokeWidth="3dp"
                android:textColor="@color/red"
                android:textAlignment="center"
                android:textAllCaps="true"
                android:backgroundTint="@color/white"
                app:icon="@drawable/ic_btn_stop"
                app:iconTint="@color/red"
                app:iconGravity="textStart"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>