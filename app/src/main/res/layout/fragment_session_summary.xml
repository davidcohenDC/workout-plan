<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>


    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_hor_fss_bottom_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="0dp"
            app:layout_constraintGuide_percent=" 0.06 " />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_hor_fss_top_stars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="0dp"
            app:layout_constraintGuide_percent=" 0.03 " />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_hor_fss_bottom_stars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="250dp"
            app:layout_constraintGuide_percent="0.29"/>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_hor_fss_top_summary_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_end="448dp"
            app:layout_constraintGuide_percent="0.2"
            />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_hor_fss_bottom_section_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.4502814" />


        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_hor_fss_bottom_summary_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_end="133dp" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_hor_fss_top_next_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="0dp"
            app:layout_constraintGuide_percent=" 0.90 " />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_vert_fss_start_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="0dp"
            app:layout_constraintGuide_percent=" 0.1 " />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_vert_fss_end_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="0dp"
            app:layout_constraintGuide_percent=" 0.9 " />

        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fontFamily="@font/telex"
            android:gravity="center"
            app:layout_constraintDimensionRatio="3:1"
            android:maxLines="1"
            android:textAllCaps="true"
            android:text="@string/summary"
            android:textSize="@dimen/_15sdp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/guide_hor_fss_bottom_title"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/guide_hor_fss_bottom_title"
            app:layout_constraintBottom_toBottomOf="@id/guide_hor_fss_bottom_section_background"
            android:background="@drawable/background_summary_gradient"/>


        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/guide_hor_fss_top_stars"
            app:layout_constraintBottom_toBottomOf="@id/guide_hor_fss_bottom_stars"
            app:lottie_rawRes="@raw/anim_get_five_starts"
            app:lottie_autoPlay="true"
            android:scaleType="fitCenter"
            app:lottie_loop="false"
            app:lottie_scale="0.9"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="@id/guide_vert_fss_start_card"
            app:layout_constraintEnd_toEndOf="@id/guide_vert_fss_end_card"
            app:layout_constraintTop_toTopOf="@id/guide_hor_fss_top_summary_card"
            app:layout_constraintBottom_toBottomOf="@id/guide_hor_fss_bottom_summary_card"
            app:layout_constraintDimensionRatio="1:1"
            app:elevation="@dimen/_4sdp"
            app:cardCornerRadius="@dimen/_10sdp">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guide_hor_fss_card_bottom_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_end="224dp"
                    app:layout_constraintGuide_percent=" 0.13 "/>

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guide_hor_fss_card_top_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_begin="0dp"
                    app:layout_constraintGuide_percent=" 0.19 " />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guide_hor_fss_card_bottom_image_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_begin="0dp"
                    app:layout_constraintGuide_percent=" 0.32 " />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guide_hor_fss_card_top_content_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_begin="0dp"
                    app:layout_constraintGuide_percent=" 0.33 " />


                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guide_hor_fss_card_bottom_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_end="138dp"
                    app:layout_constraintGuide_percent=" 0.45 " />


                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guide_hor_fss_card_mid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_begin="0dp"
                    app:layout_constraintGuide_percent=" 0.53 " />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guide_hor_fss_card_top_content_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_begin="0dp"
                    app:layout_constraintGuide_percent=" 0.59 " />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guide_hor_fss_card_bottom_image_content_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_begin="0dp"
                    app:layout_constraintGuide_percent=" 0.72 " />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guide_hor_fss_card_top_content_description2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_begin="0dp"
                    app:layout_constraintGuide_percent=" 0.73 " />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guide_hor_fss_card_bottom_description_content_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_begin="0dp"
                    app:layout_constraintGuide_percent=" 0.85 " />



                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guide_vert_fss_card_mid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_begin="0dp"
                    app:layout_constraintGuide_percent=" 0.5 " />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:background="@color/teal_700"
                    android:alpha="0.1"
                    app:layout_constraintTop_toTopOf="@id/guide_hor_fss_card_bottom_title"/>

                <View
                    android:layout_width="@dimen/_1sdp"
                    android:layout_height="0dp"
                    android:alpha="0.1"
                    android:background="@color/teal_700"
                    app:layout_constraintTop_toTopOf="@id/guide_hor_fss_card_bottom_title"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:background="@color/teal_700"
                    android:alpha="0.1"
                    app:layout_constraintTop_toTopOf="@id/guide_hor_fss_card_mid"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>


                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/txt_title_summary"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="parent"
                    android:maxLines="1"
                    app:autoSizeTextType="uniform"
                    android:text="@string/statistics_of_workout"
                    android:textStyle="bold"
                    app:layout_constraintDimensionRatio="V,4:1"
                    android:gravity="center"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="@id/guide_hor_fss_card_bottom_title"
                    app:layout_constraintEnd_toEndOf="parent"/>


                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/image_first_dial"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_total_time_summary"
                    app:layout_constraintBottom_toBottomOf="@id/guide_hor_fss_card_bottom_image_content"

                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="@id/guide_vert_fss_card_mid"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/guide_hor_fss_card_top_content"
                    app:layout_constraintVertical_bias="0.0" />

                <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_first_dial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 minutes"
                android:textStyle="bold"
                android:maxLines="1"
                android:gravity="center"
                    android:textSize="@dimen/_10sdp"
                app:layout_constraintBottom_toTopOf="@id/txt_title_first_dial"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="@id/guide_vert_fss_card_mid"
                app:layout_constraintTop_toTopOf="@id/guide_hor_fss_card_top_content_description"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/txt_title_first_dial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seconds"
                    android:maxLines="1"
                    android:gravity="center"
                    android:textSize="@dimen/_8sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="@id/guide_vert_fss_card_mid"
                    app:layout_constraintTop_toBottomOf="@id/text_first_dial"
                    app:layout_constraintBottom_toBottomOf="@id/guide_hor_fss_card_bottom_content"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/image_second_dial"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintStart_toStartOf="@id/guide_vert_fss_card_mid"
                    app:elevation="@dimen/_2sdp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_total_rep_summary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/guide_hor_fss_card_top_content"
                    app:layout_constraintBottom_toBottomOf="@id/guide_hor_fss_card_bottom_image_content"
                    app:layout_constraintDimensionRatio="1:1"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_second_dial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="53"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:gravity="center"
                    android:textSize="@dimen/_10sdp"
                    app:layout_constraintBottom_toTopOf="@id/txt_title_second_dial"
                    app:layout_constraintStart_toStartOf="@id/guide_vert_fss_card_mid"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/guide_hor_fss_card_top_content_description"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/txt_title_second_dial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Repetiton"
                    android:maxLines="1"
                    android:gravity="center"
                    android:textSize="@dimen/_8sdp"
                    app:layout_constraintStart_toStartOf="@id/guide_vert_fss_card_mid"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/text_second_dial"
                    app:layout_constraintBottom_toBottomOf="@id/guide_hor_fss_card_bottom_content"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/image_four_dial"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintStart_toStartOf="@id/guide_vert_fss_card_mid"
                    app:elevation="@dimen/_2sdp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_final_vote_summary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/guide_hor_fss_card_top_content_2"
                    app:layout_constraintBottom_toBottomOf="@id/guide_hor_fss_card_bottom_image_content_2"
                    app:layout_constraintDimensionRatio="1:1"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_four_dial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="80%"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:gravity="center"
                    android:textSize="@dimen/_10sdp"
                    app:layout_constraintBottom_toTopOf="@id/txt_title_four_dial"
                    app:layout_constraintStart_toStartOf="@id/guide_vert_fss_card_mid"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/guide_hor_fss_card_top_content_description2"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/txt_title_four_dial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completition"
                    android:maxLines="1"
                    android:gravity="center"
                    android:textSize="@dimen/_8sdp"
                    app:layout_constraintStart_toStartOf="@id/guide_vert_fss_card_mid"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/text_four_dial"
                    app:layout_constraintBottom_toBottomOf="@id/guide_hor_fss_card_bottom_description_content_2"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/image_third_dial"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:elevation="@dimen/_2sdp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_total_set_summary"
                    app:layout_constraintEnd_toEndOf="@id/guide_vert_fss_card_mid"
                    app:layout_constraintTop_toTopOf="@id/guide_hor_fss_card_top_content_2"
                    app:layout_constraintBottom_toBottomOf="@id/guide_hor_fss_card_bottom_image_content_2"
                    app:layout_constraintDimensionRatio="1:1"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_third_dial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:gravity="center"
                    android:textSize="@dimen/_10sdp"
                    app:layout_constraintBottom_toTopOf="@id/txt_title_third_dial"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="@id/guide_vert_fss_card_mid"
                    app:layout_constraintTop_toTopOf="@id/guide_hor_fss_card_top_content_description2"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/txt_title_third_dial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Set"
                    android:textSize="@dimen/_8sdp"
                    app:layout_constraintBottom_toBottomOf="@id/guide_hor_fss_card_bottom_description_content_2"
                    app:layout_constraintEnd_toEndOf="@id/guide_vert_fss_card_mid"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/text_third_dial" />



            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            app:layout_constraintTop_toTopOf="@id/guide_hor_fss_top_next_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/guide_vert_fss_start_card"
            app:layout_constraintEnd_toEndOf="@id/guide_vert_fss_end_card"
            android:text="Next"
            android:elevation="@dimen/_2sdp"
            android:textSize="@dimen/_10sdp"
            app:cornerRadius="@dimen/_70sdp"
 />



    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
