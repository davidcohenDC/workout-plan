<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="sessionViewModel"
            type="com.example.workoutplan.viewmodels.SessionViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/txt_title_rep"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginVertical="@dimen/_8sdp"
            android:fontFamily="@font/telex"
            android:gravity="center"
            android:text="@string/repetition"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/divider_stat_1"/>


        <View
            android:id="@+id/divider_stat_1"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:alpha="0.2"
            android:background="@drawable/simple_line"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:layout_editor_absoluteY="54dp"
            app:layout_constraintTop_toBottomOf="@id/txt_title_rep"
            app:layout_constraintBottom_toTopOf="@id/number_picker_rep"/>

        <com.shawnlin.numberpicker.NumberPicker
            android:id="@+id/number_picker_rep"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginVertical="@dimen/_15sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:np_dividerColor="@color/primaryDarkColor"
            app:np_dividerDistance="@dimen/_60sdp"
            app:np_fadingEdgeEnabled="true"
            app:np_max="50"
            app:np_min="1"
            app:np_orientation="horizontal"
            app:np_textColor="@color/primaryLightColor"
            app:np_scrollerEnabled="true"
            app:np_wheelItemCount="5"
            app:np_wrapSelectorWheel="true"
            tools:layout_editor_absoluteY="78dp"
            app:layout_constraintTop_toBottomOf="@id/divider_stat_1"
            app:layout_constraintBottom_toTopOf="@id/txt_title_weight"/>

        <TextView
            android:id="@+id/txt_title_weight"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginVertical="@dimen/_8sdp"
            android:fontFamily="@font/telex"
            android:gravity="center"
            android:text="@string/weight"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:layout_editor_absoluteY="123dp"
            app:layout_constraintTop_toBottomOf="@id/number_picker_rep"
            app:layout_constraintBottom_toTopOf="@id/divider_title_2"/>

        <View
            android:id="@+id/divider_title_2"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:alpha="0.2"
            android:background="@drawable/simple_line"
            app:layout_constraintBottom_toTopOf="@id/number_picker_weight"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txt_title_weight" />

        <com.shawnlin.numberpicker.NumberPicker
            android:id="@+id/number_picker_weight"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginVertical="@dimen/_15sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:np_dividerColor="@color/primaryDarkColor"
            app:np_dividerDistance="@dimen/_60sdp"
            app:np_fadingEdgeEnabled="true"
            app:np_max="50"
            app:np_min="1"
            app:np_orientation="horizontal"
            app:np_scrollerEnabled="true"
            app:np_textColor="@color/primaryLightColor"
            app:np_wheelItemCount="5"
            app:np_wrapSelectorWheel="true"
            app:layout_constraintTop_toBottomOf="@id/divider_title_2"
            app:layout_constraintBottom_toTopOf="@id/txt_title_duration"/>

        <TextView
            android:id="@+id/txt_title_duration"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginVertical="@dimen/_8sdp"
            android:fontFamily="@font/telex"
            android:gravity="center"
            android:text="@string/duration"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/number_picker_weight"
            app:layout_constraintBottom_toTopOf="@id/divider_title_3" />

        <View
            android:id="@+id/divider_title_3"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:alpha="0.2"
            android:background="@drawable/simple_line"
            app:layout_constraintBottom_toTopOf="@id/number_picker_duration"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txt_title_duration" />

        <com.shawnlin.numberpicker.NumberPicker
            android:id="@+id/number_picker_duration"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginVertical="@dimen/_15sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:np_typeface="@android:string/VideoView_error_button"
            app:np_dividerColor="@color/primaryDarkColor"
            app:np_dividerDistance="@dimen/_60sdp"
            app:np_fadingEdgeEnabled="true"
            app:np_max="50"
            app:np_min="1"
            app:np_orientation="horizontal"
            app:np_scrollerEnabled="true"
            app:np_wheelItemCount="5"
            app:np_textColor="@color/primaryLightColor"
            app:np_wrapSelectorWheel="true"
            app:layout_constraintTop_toBottomOf="@id/divider_title_3"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>