<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:fitsSystemWindows="true">

<!--        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                style="@style/Widget.MaterialComponents.Toolbar.Primary"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="@drawable/ic_detail_back"
                app:menu="@menu/menu_workout_input"
                app:title="Category" />

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_anchorGravity="center"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">


            <androidx.constraintlayout.widget.Guideline
            android:id="@+id/titleTextViewGuideline"
            android:layout_width = "wrap_content"
            android:layout_height = "wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin = "0dp"
            app:layout_constraintGuide_percent = " .2 " />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/titleTextViewGuideline3"
                android:layout_width = "wrap_content"
                android:layout_height = "wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin = "0dp"
                app:layout_constraintGuide_percent = " .8 " />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/titleTextViewGuideline2"
                android:layout_width = "wrap_content"
                android:layout_height = "wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin = "0dp"
                app:layout_constraintGuide_percent = " .5 " />

            <TextView
                android:id="@+id/title_setup_category"
                style="@style/TextAppearance.MaterialComponents.Headline4"
                android:layout_width="0dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:gravity="center"
                android:maxLines="2"
                android:layout_height="wrap_content"
                android:text="@string/pick_your_favorite_category"
                android:textAlignment="center"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/titleTextViewGuideline"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_first"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="16dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintHeight_percent=".21"
                android:checkable="true"
                android:clickable="true"
                android:focusable="true"
                app:cardElevation="4dp"
                app:layout_constraintBottom_toTopOf="@id/titleTextViewGuideline2"
                app:layout_constraintEnd_toStartOf="@id/card_second"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/titleTextViewGuideline"
                app:strokeColor="@color/black"
                app:strokeWidth="1dp"
                >

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/titleTextViewGuideline4"
                        android:layout_width = "wrap_content"
                        android:layout_height = "wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_begin = "0dp"
                        app:layout_constraintGuide_percent = " .8 " />

                    <ImageView
                        android:id="@+id/image_first"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintHeight_percent="0.55"
                        tools:srcCompat="@drawable/ic_baseline_local_fire"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="@id/titleTextViewGuideline4"/>

                    <TextView
                        android:id="@+id/text_first"
                        style="?attr/textAppearanceBody1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:maxLines="1"
                        tools:text="@string/strength"
                        android:textAlignment="center"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/titleTextViewGuideline4" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_second"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="8dp"
                android:checkable="true"
                android:clickable="true"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintHeight_percent=".21"
                android:focusable="true"
                app:cardElevation="4dp"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintBottom_toBottomOf="@id/titleTextViewGuideline2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/card_first"
                app:layout_constraintTop_toTopOf="@+id/titleTextViewGuideline"
                app:strokeColor="@color/black"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/titleTextViewGuideline5"
                        android:layout_width = "wrap_content"
                        android:layout_height = "wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_begin = "0dp"
                        app:layout_constraintGuide_percent = " .8 " />

                    <ImageView
                        android:id="@+id/image_second"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintHeight_percent="0.55"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:src="@drawable/ic_drop"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="@id/titleTextViewGuideline5"/>

                    <TextView
                        android:id="@+id/text_second"
                        style="?attr/textAppearanceBody1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:maxLines="1"
                        android:textAlignment="center"
                        tools:text="@string/cardio"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/titleTextViewGuideline5" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_third"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintHeight_percent=".21"
                android:checkable="true"
                android:clickable="true"
                android:focusable="true"
                app:cardElevation="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/titleTextViewGuideline3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/titleTextViewGuideline2"
                app:strokeColor="@color/black"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/titleTextViewGuideline6"
                        android:layout_width = "wrap_content"
                        android:layout_height = "wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_begin = "0dp"
                        app:layout_constraintGuide_percent = " .8 " />

                    <ImageView
                        android:id="@+id/image_thirdimage_third"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintHeight_percent="0.55"
                        tools:srcCompat="@drawable/ic_baseline_health_and_safety_24"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="@id/titleTextViewGuideline6"/>

                    <TextView
                        android:id="@+id/textView"
                        style="?attr/textAppearanceBody1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:maxLines="1"
                        android:textAlignment="center"
                        tools:text="@string/healthy"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/titleTextViewGuideline6" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/next_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/next"
                android:textAlignment="center"
                android:textAllCaps="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/titleTextViewGuideline3"
                app:layout_constraintVertical_bias="1.0" />

        </androidx.constraintlayout.widget.ConstraintLayout>-->

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>